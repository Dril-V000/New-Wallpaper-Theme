{
  "manifest_version": 3,
  "author": "code-7",
  "name": "New Wallpaper Theme",
  "description": "Made by code-7 and claude",
  "version": "1.2",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "img/128.png"
  },
  "action": {
    "default_icon": "img/128.png",
    "default_title": "New Tab"
  }
}